<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FortiGateUpgrader.Core\FortiGateUpgrader.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>FortiGateUpgrader</AssemblyName>
    <Product>FortiGate Config Upgrader</Product>
    <Version>1.1.0</Version>
    <!-- Exe icon, rendered from Assets/fortinet.svg -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Window / taskbar icon -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Profiles are built into the exe. A "Profiles" folder placed next to the exe overrides them. -->
    <EmbeddedResource Include="..\..\profiles\**\*" LogicalName="Profiles/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
  </ItemGroup>

</Project>